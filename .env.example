# Optional: uncomment and supply BOTH values to override npm run connect.
# Defined blank values and partial pairs are rejected. Room codes normalize to uppercase.
# PINGROOM_TOKEN=your-robot-token
# PINGROOM_ROOM=YOUR_ROOM_CODE

# Optional local archive directory. Relative paths resolve from your working directory.
# ARCHIVE_DIR=./archive
# Page budget per scan, 1–40; each page contains at most 25 notifications.
# ARCHIVE_MAX_PAGES=40
